---
import { SITE } from '$/config'
import BaseHead from '$/components/BaseHead.astro';
import MainLayout from '$/components/MainLayout.astro';

const { content, showPageHeader = true } = Astro.props
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE.title} description={content.description} image={SITE.image}/>
    </head>
    <MainLayout>
        {showPageHeader &&
            <div class="page__header">
                <h1 class="page__title">{content.title}</h1>
                <p class="page__desc">{content.description}</p>
            </div>
        }
        <slot />
    </MainLayout>
</html>
<style>
    .page__header {
        @apply mb-5 pt-1;
        max-width: 52rem;
    }
    .page__title {
        @apply text-3xl font-bold leading-tight md:text-4xl;
        color: var(--ink);
        font-family: var(--font-display);
        letter-spacing: -0.02em;
    }
    .page__desc {
        @apply mt-1 text-sm;
        color: var(--muted);
    }
</style>
