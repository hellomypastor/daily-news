---
import { SITE } from '$/config'
import BaseHead from '$/components/BaseHead.astro';
import MainLayout from '$/components/MainLayout.astro';

const { content, showPageHeader = true } = Astro.props
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE.title} description={content.description} image={SITE.image}/>
    </head>
    <MainLayout>
        {showPageHeader &&
            <div class="page__header">
                <p class="page__eyebrow">Daily signal desk</p>
                <h1 class="page__title">{content.title}</h1>
                <p class="page__desc">{content.description}</p>
            </div>
        }
        <slot />
    </MainLayout>
</html>
<style>
    .page__header {
        @apply mb-6 pb-5 pt-2;
        max-width: 52rem;
    }
    .page__eyebrow {
        @apply mb-2 text-xs font-semibold uppercase tracking-[0.2em];
        color: var(--signal-cyan);
    }
    .page__title {
        @apply text-4xl font-semibold leading-tight md:text-6xl;
        color: var(--ink);
        font-family: var(--font-display);
        letter-spacing: -0.035em;
    }
    .page__desc {
        @apply mt-3 text-base md:text-lg;
        color: var(--muted);
    }
</style>
