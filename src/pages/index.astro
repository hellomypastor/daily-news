---
export const prerender = true;

import { getCollection } from "astro:content";
import DefaultPageLayout from "$/layouts/default.astro";
import PostPreviewList from "$/components/PostPreviewList.astro";

const TOPIC_ORDER = ["claude", "openai", "open-source", "ai-industry", "aaas"];
const calendarDate = (date: string) => date.slice(0, 10);
const topicRank = (slug: string) => {
  const topic = TOPIC_ORDER.find((candidate) => slug.endsWith(`_${candidate}`));
  return topic ? TOPIC_ORDER.indexOf(topic) : TOPIC_ORDER.length;
};

const posts = (await getCollection("blog")).sort((a, b) =>
  calendarDate(b.data.date).localeCompare(calendarDate(a.data.date)) ||
  topicRank(a.slug) - topicRank(b.slug) ||
  a.data.title.localeCompare(b.data.title)
);

const latestDate = posts[0] ? calendarDate(posts[0].data.date) : undefined;
const todaysPosts = latestDate
  ? posts.filter((post) => calendarDate(post.data.date) === latestDate).slice(0, 5)
  : [];
const highlights = posts.filter((post) => !todaysPosts.some((today) => today.slug === post.slug)).slice(0, 10);

const content = {
  title: "Latest",
  description: latestDate
    ? `Five AI and Agent briefings for ${latestDate}.`
    : "No briefings have been published yet.",
};
---

<DefaultPageLayout {content} showPageHeader={false}>
  <div class="home-grid">
    <section>
      <h2 class="edition-date">{latestDate}</h2>
      {todaysPosts.length > 0 ? <PostPreviewList posts={todaysPosts} mode="signal" /> : <p>No briefings have been published yet.</p>}
    </section>
    <aside class="highlights">
      <h2>Highlights</h2>
      <ul>{highlights.map((post) => <li><a href={`/blog/${post.slug}`}>{post.data.title}</a><span> — {calendarDate(post.data.date)}</span></li>)}</ul>
    </aside>
  </div>
</DefaultPageLayout>

<style>
  .edition-date {
    @apply mb-2 pb-2 text-xl font-bold;
    color: var(--ink);
  }
  .home-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(250px, 1fr); gap: 3.5rem; }
  .highlights h2 { @apply mb-4 text-xl font-bold; }
  .highlights li { @apply mb-3 text-sm leading-5; }
  .highlights span { color: var(--muted); }
  @media (max-width: 760px) { .home-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
