---
export const prerender = true;

import { getCollection } from "astro:content";
import DefaultPageLayout from "$/layouts/default.astro";
import PostPreviewList from "$/components/PostPreviewList.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) =>
    new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf() ||
    a.data.title.localeCompare(b.data.title)
);

const latestDate = posts[0]?.data.date.slice(0, 10);
const todaysPosts = latestDate
  ? posts.filter((post) => post.data.date.slice(0, 10) === latestDate).slice(0, 5)
  : [];

const content = {
  title: "Today's Briefings",
  description: latestDate
    ? `${latestDate} · ${todaysPosts.length} focused AI & Agent reports`
    : "No briefings have been published yet.",
};
---

<DefaultPageLayout {content}>
  {todaysPosts.length > 0 ? (
    <PostPreviewList posts={todaysPosts} />
  ) : (
    <p>No briefings have been published yet.</p>
  )}
</DefaultPageLayout>
