---
import Comment from "$/components/Comment.svelte";
---

<article class="prose dark:prose-dark">
  <slot />
  <Comment client:load />
</article>

<style>
  .prose {
    @apply max-w-4xl
        /* Size Modifiers: https://github.com/tailwindlabs/tailwindcss-typography#size-modifiers */
        /* Color Themes: https://github.com/tailwindlabs/tailwindcss-typography#color-modifiers */;
  }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .prose :global(figure.source-image) {
    margin: 1.5rem 0 2rem;
  }
  .prose :global(figure.source-image img) {
    display: block;
    width: 100%;
    max-height: 42rem;
    object-fit: contain;
    border: 1px solid var(--line-strong);
  }
  .prose :global(figure.source-image figcaption) {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .prose :global(figure.source-image figcaption a) {
    color: var(--link);
    text-decoration: underline;
  }
</style>
