---
import { SITE } from "$/config";
import SvgIcon from "./SvgIcon.astro";
import ModeSwitcherBtn from "./ModeSwitcherBtn.svelte";
import SearchBtn from "./SearchBtn.svelte";
---

<header class="header">
  <div class="header__identity">
    <p class="header__eyebrow">AI / Agent intelligence</p>
    <h1 class="header__title">
      <a href="/">{SITE.name}</a>
    </h1>
    <p class="header__desc">{SITE.description}</p>
  </div>
  <div class="header__tools">
    <a href="/" class="header__mark" aria-label="Go to today's briefings">
      <img src="/assets/logo.png" alt="" />
    </a>
    <nav aria-label="Site tools">
      <ul class="header__ref-list">
          <li>
            <SearchBtn client:visible />
          </li>
          <li>
            <a href={SITE.githubUrl} title={`${SITE.name}'s Github URL'`}>
              <SvgIcon>
                <path
                  d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path>
              </SvgIcon>
            </a>
          </li>
          <li>
            <a href="/rss.xml" title="RSS">
              <SvgIcon>
                <path d="M4 11a9 9 0 0 1 9 9"></path>
                <path d="M4 4a16 16 0 0 1 16 16"></path>
                <circle cx="5" cy="19" r="1"></circle>
              </SvgIcon>
            </a>
          </li>
          <li>
            <ModeSwitcherBtn client:visible />
          </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    @apply flex items-end justify-between gap-6 border-b py-8;
    border-color: var(--line-strong);
  }
  .header__identity {
    min-width: 0;
  }
  .header__eyebrow {
    @apply mb-2 text-xs font-semibold uppercase tracking-[0.2em];
    color: var(--signal-orange);
  }
  .header__title {
    @apply text-5xl font-semibold leading-none md:text-7xl;
    color: var(--ink);
    font-family: var(--font-display);
    letter-spacing: -0.045em;
  }
  .header__desc {
    @apply mt-3 text-sm md:text-base;
    color: var(--muted);
  }
  .header__tools {
    @apply flex shrink-0 items-center gap-5;
  }
  .header__mark img {
    @apply h-14 w-14 object-contain md:h-16 md:w-16;
    filter: saturate(0.8);
  }
  .header__ref-list {
    @apply flex gap-3;
    color: var(--muted);
  }
  .header__ref-list a {
    @apply transition-colors;
  }
  .header__ref-list a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .header {
      @apply items-start py-6;
    }
    .header__title {
      @apply text-4xl;
    }
    .header__mark {
      display: none;
    }
    .header__desc {
      max-width: 18rem;
    }
  }
</style>
