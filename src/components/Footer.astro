---
import { SITE } from "$/config";

const currentYear = new Intl.DateTimeFormat("en", {
  timeZone: "Asia/Shanghai",
  year: "numeric",
}).format(new Date());
---

<footer class="footer">
  <nav class="nav">
    <div>
      &copy; {currentYear} <a
        href={SITE.githubUrl}
        title={`${SITE.name}'s Github URL'`}>{SITE.name}</a
      >
    </div>
  </nav>
</footer>
<style>
  .footer {
    @apply py-6 border-t;
  }
</style>
