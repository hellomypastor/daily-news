---
import { toTitleCase } from "$/utils";
import { NAV_ITEMS } from "$/config";
---

<div class="update-strip"><strong>Updated:</strong> every 3 hours · five independent AI briefings, one rolling edition</div>
<nav class="nav">
  <ul class="nav-list" transition:animate="fade">
    {
      Object.keys(NAV_ITEMS).map((navItemKey) => (
        <li>
          <a
            class:list={[
              "nav-link",
              Astro.url.pathname === NAV_ITEMS[navItemKey].path ||
              (NAV_ITEMS[navItemKey].path !== "/" && Astro.url.pathname.startsWith(`${NAV_ITEMS[navItemKey].path}/`))
                ? "nav-link--active"
                : "",
            ]}
            href={NAV_ITEMS[navItemKey].path}
            title={NAV_ITEMS[navItemKey].title}
          >
            {toTitleCase(NAV_ITEMS[navItemKey].title)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style>
  .nav-list {
    @apply flex list-none flex-wrap gap-x-6 px-3;
  }
  .nav-link {
    @apply inline-block py-1.5 text-sm text-white;
  }
  .nav-link:hover,
  .nav-link--active {
    color: #fff; text-decoration: underline;
  }
  .nav { margin-inline: calc(50% - 50vw); padding-inline: calc(50vw - 50%); background: var(--nav); }
  .update-strip { margin-inline: calc(50% - 50vw); padding: .55rem max(calc(50vw - 50%), .75rem); background: var(--notice); color: #324b5c; font-size: .82rem; }
  html.dark .update-strip { color: #d2e1e8; }
</style>
