---
import { toTitleCase } from "$/utils";
import { NAV_ITEMS } from "$/config";
---

<nav class="nav py-3">
  <ul class="nav-list" transition:animate="fade">
    {
      Object.keys(NAV_ITEMS).map((navItemKey) => (
        <li>
          <a
            class:list={[
              "nav-link",
              Astro.url.pathname === NAV_ITEMS[navItemKey].path ||
              (NAV_ITEMS[navItemKey].path !== "/" && Astro.url.pathname.startsWith(`${NAV_ITEMS[navItemKey].path}/`))
                ? "nav-link--active"
                : "",
            ]}
            href={NAV_ITEMS[navItemKey].path}
            title={NAV_ITEMS[navItemKey].title}
          >
            {toTitleCase(NAV_ITEMS[navItemKey].title)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<style>
  .nav-list {
    @apply flex list-none flex-wrap gap-x-7 gap-y-2;
  }
  .nav-link {
    @apply inline-block py-2 text-xs font-semibold uppercase tracking-[0.16em] transition-colors;
    color: var(--muted);
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover,
  .nav-link--active {
    color: var(--ink);
    border-bottom-color: var(--signal-orange);
  }
</style>
